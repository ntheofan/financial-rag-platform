.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
.eggs/
build/
dist/

# IDE and operating-system files
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Local logs and runtime state
*.log
logs/
uploads/
artifacts/
outputs/
pgdata/
.postgres/
*.db
*.sqlite
*.sqlite3

# Model and package caches
.cache/
model-cache/
models/
huggingface/
.huggingface/

# Binary, vector, and derived dataset artifacts
*.7z
*.gz
*.rar
*.tar
*.tgz
*.zip
*.faiss
*.index
*.npy
*.npz
*.pkl
*.pickle
*.parquet
*.arrow
*.pdf
*.retrieval.json*
