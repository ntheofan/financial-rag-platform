# Keep the local research data tree, but publish none of its contents.
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Local benchmark and evaluation runs outside data/
/benchmarks/local/
/evaluation-runs/

# Immutable thesis artifacts require a separate manual publication clearance.
/notebooks/*.ipynb
/notebooks/figures/
