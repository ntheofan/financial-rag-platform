# Copy this file to .env and keep every real value and machine path local.
APP_ENV=development
LOG_LEVEL=INFO
API_DOCS_ENABLED=true
# Local development example only. Replace in your untracked .env.
DATABASE_URL=postgresql+asyncpg://financial_rag:financial_rag@localhost:5432/financial_rag
DATABASE_ENABLED=false
DATABASE_SMOKE_ON_STARTUP=false
RUNTIME_CONFIG_PATH=configs/runtime/local_v1.json
# Point only to an ignored local retrieval artifact directory when one exists.
RETRIEVAL_ARTIFACT_DIRECTORY=
# Server-owned temporary upload staging. Contents are deleted after each job.
UPLOAD_STAGING_DIRECTORY=uploads
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GENERATION_TIMEOUT_SECONDS=30
GENERATION_MAX_RETRIES=2
GENERATION_MAX_OUTPUT_TOKENS=1000
FINANCIAL_RAG_API_URL=http://127.0.0.1:8000
DEMO_REQUEST_TIMEOUT_SECONDS=90

# Docker Compose local-only overrides. Never reuse these credentials outside
# the loopback-bound development stack.
POSTGRES_DB=financial_rag
POSTGRES_USER=financial_rag
POSTGRES_PASSWORD=financial_rag_local_only
POSTGRES_PORT=5432
API_PORT=8000
DEMO_PORT=8501
# Set to /runtime/artifacts only when ./artifacts contains a compatible ignored
# Retrieval artifact. Leave blank for health/OpenAPI-only startup.
CONTAINER_RETRIEVAL_ARTIFACT_DIRECTORY=
